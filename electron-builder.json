{
  "appId": "com.conectvy.app",
  "productName": "Conectvy",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "electron/main.js",
    "electron/preload.js",
    ".next/standalone/**/*",
    ".next/static/**/*",
    "public/**/*"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "app"
    },
    {
      "from": ".next/static",
      "to": "app/.next/static"
    },
    {
      "from": "public",
      "to": "app/public"
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "target": "dmg",
    "icon": "resources/icon.icns"
  }
}
