{
  "appId": "com.conectvy.app",
  "productName": "Conectvy",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "electron/main.js",
    "electron/preload.js"
  ],
  "extraResources": [
    {
      "from": ".next/standalone/conectvy",
      "to": "app"
    },
    {
      "from": ".next/static",
      "to": "app/.next/static"
    },
    {
      "from": "public",
      "to": "app/public"
    }
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "target": "dmg"
  }
}
