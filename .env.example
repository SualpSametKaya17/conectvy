# ─── MSSQL Bağlantı Bilgileri ─────────────────────────────────────────────────
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=ConectvyDB
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong@Passw0rd
# Lokal / self-signed sertifika için true, prod ortamda false yap
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ─── Güvenlik ──────────────────────────────────────────────────────────────────
# En az 32 karakter rastgele bir string — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
# Şifreli veri için master key — aynı komutla üret
ENCRYPTION_KEY=change-me-to-another-random-key-at-least-32-chars

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Conectvy"
NEXT_PUBLIC_APP_VERSION="0.1.0"
